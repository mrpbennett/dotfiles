;; kanata — home row mods + nav layer (replaces karabiner.json)
;; Reload: sudo launchctl kickstart -k system/dev.kanata.kanata
;; Emergency exit while running in foreground: lctl+spc+esc

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  ;; a key typed <150ms after another key is always a tap — no mod misfires mid-word
  tap-hold-require-prior-idle 150
)

(defsrc
  ;; function row — macOS: required, or the media keys (brightness/volume/etc) are swallowed
  ;; Linux: can be dropped; process-unmapped-keys passes them through
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
       z    x    c    v    b    n    m    ,    .    /
  spc  left rght up   down
  fn   rmet lmet
)

(defvar
  ;; tap-repress window: tap a key, then press+hold it again within this → the letter repeats
  ;; (hold j to scroll in vim = tap j, then hold j)
  tap  200
  ;; hold this long to get the modifier
  hold 200
)

(defalias
  ;; esc must be forgiving: a slow tap (>200ms) became ctrl, so nvim stayed in insert mode
  cap (tap-hold 300 300 esc lctl)

  ;; home row mods: ctrl opt cmd shift | shift cmd opt ctrl
  a (tap-hold-release $tap $hold a lctl)
  s (tap-hold-release $tap $hold s (multi lalt (layer-while-held alt)))
  d (tap-hold-release $tap $hold d lmet)
  f (tap-hold-release $tap $hold f lsft)
  j (tap-hold-release $tap $hold j rsft)
  k (tap-hold-release $tap $hold k rmet)
  l (tap-hold-release $tap $hold l (multi ralt (layer-while-held alt)))
  ; (tap-hold-release $tap $hold ; rctl)

  ;; cmd+bspc → opt+bspc (delete word)
  bs (fork bspc (unmod (lmet rmet) lalt bspc) (lmet rmet))

  nav (layer-while-held nav)

  ;; nav layer: arrows; +opt passes through; +cmd h/l → opt+arrow; +ctrl → ctrl+fn+arrow
  nh (fork (fork left (unmod (lmet rmet) lalt left) (lmet rmet)) (multi fn left) (lctl rctl))
  nj (fork down (multi fn down) (lctl rctl))
  nk (fork up (multi fn up) (lctl rctl))
  nl (fork (fork right (unmod (lmet rmet) lalt right) (lmet rmet)) (multi fn right) (lctl rctl))
  ;; nav+bspc → forward delete; nav+cmd+bspc → ctrl+forward delete
  nbs (fork del (unmod (lmet rmet) lctl del) (lmet rmet))
)

(deflayer base
  ;; function row — macOS: F1-F12 map to media keys (brightness, mission ctrl, launchpad, prev/play/next, mute, vol)
  brdn brup mctl lpad f5   f6   prev pp   next mute vold volu
  ;; function row — Linux/plain F-keys alternative (swap in for the line above):
  ;; f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    @bs
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap @a   @s   @d   @f   g    h    @j   @k   @l   @;   '    ret
       z    x    c    v    b    n    m    ,    .    /
  spc  left rght up   down
  fn   lmet @nav
)

;; nav layer is on physical left cmd, so every key except hjkl/bspc sends cmd+key (cmd+c, cmd+v, ...)
(deflayer nav
  ;; function row — passthrough (same on macOS and Linux)
  _    _    _    _    _    _    _    _    _    _    _    _
  M-grv M-1  M-2  M-3  M-4  M-5  M-6  M-7  M-8  M-9  M-0  M--  M-=  @nbs
  M-tab M-q  M-w  M-e  M-r  M-t  M-y  M-u  M-i  M-o  M-p  M-[  M-]  M-\
  _     M-a  M-s  M-d  M-f  M-g  @nh  @nj  @nk  @nl  M-;  M-'  M-ret
        M-z  M-x  M-c  M-v  M-b  M-n  M-m  M-,  M-.  M-/
  M-spc M-left M-rght M-up M-down
  _     _    _
)

;; while s/l (opt) is held, j/k are plain keys so opt+j / opt+k (move line) fire immediately
;; instead of waiting on their own home-row-mod tap-hold
(deflayer alt
  ;; function row — passthrough (same on macOS and Linux)
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ j k _ _ _ _
    _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _
  _ _ _
)
