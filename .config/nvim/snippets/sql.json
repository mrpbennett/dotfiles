{
  "OUS CRM": {
    "prefix": "ous_crm",
    "body": [
      "with hashed_guids as (",
      "    select distinct guid, to_hex(sha256(to_utf8(guid))) as hashed_guid",
      "    from thirdparty.medscape_pii_meta_global",
      "    where day = (",
      "        select max(day) as latest_partition",
      "        from thirdparty.\"medscape_pii_meta_global$partitions\"",
      "     )",
      "",
      "    union",
      "",
      "    select distinct guid, to_hex(sha256(to_utf8(guid))) AS hashed_guid",
      "    from thirdparty.medscape_pii_meta_combined",
      "    where day = (",
      "        select max(day) as latest_partition",
      "        from thirdparty.\"medscape_pii_meta_combined$partitions\"",
      "     )",
      "),"
    ],
    "description": "OUS CRM Data"
  },
