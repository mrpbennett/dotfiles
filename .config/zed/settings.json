// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "soft_wrap": "editor_width",
  "icon_theme": "Catppuccin Mocha",
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.0,
  "ui_font_size": 15.0,
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Everforest Dark Hard (material)",
  },

  // vim settings ---
  "vim_mode": true,
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "scroll_beyond_last_line": "off",
  "scrollbar": {
    "show": "never",
  },
  // vim settings end ---

  "terminal": {
    "button": true,
    "font_size": 13.0,
    "font_family": "JetBrains Mono",
  },

  // UI --
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": true,
  },
  "project_panel": {
    "button": false,
    "dock": "left",
    "default_width": 350,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "sticky_scroll": false,
    "indent_guides": {
      "show": "never",
    },
    "scrollbar": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "git_panel": {
    "dock": "left",
    "button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "search": {
    "button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "",
      },
    },
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "",
      },
    },
  },
  "edit_predictions": {
    "enabled_in_text_threads": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "colorize_brackets": true,
  "disable_ai": false,
  "show_edit_predictions": false,
  "agent": {
    "dock": "right",
    "button": false,
    "default_width": 350,
    "tool_permissions": {
      "default": "allow",
    },
    "favorite_models": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "default_profile": "write",
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "/Users/pbennett/.local/bin/claude",
      },
    },
    "opencode": {
      "default_config_options": {
        "model": "openai/gpt-5.6-luna-pro",
      },
      "type": "registry",
    },
  },
  "diagnostics": {
    "button": false,
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "enabled": true,
  },

  //
  // Indivdual language settings :::
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
    },
    "YAML": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": "language_server",
    },
  },
  // language server settings : python - go - yaml
  "lsp": {
    // PYTHON
    "ruff": {
      "initialization_options": {
        "lineLength": 80,
        "lint": {
          "extendSelect": ["I"],
          "quoteStyle": "single",
          "docstringCodeFormat": true,
        },
      },
    },
    // GO
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
      },
    },
    // YAML
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "keyOrdering": false,
          "validate": true,
          "completion": true,
          "hover": true,
          "editor": {
            "tabSize": 2,
          },
          "format": {
            "enable": true,
            "singleQuote": true,
          },
          "schemaStore": {
            "enable": true,
          },
          "schemas": {
            "kubernetes": "**/*.yaml",
          },
        },
      },
    },
  },
}
