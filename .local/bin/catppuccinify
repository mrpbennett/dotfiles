#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["numpy", "pillow"]
# ///
"""Recolor an image to the Catppuccin Mocha palette.

Each color is mapped to a Gaussian-weighted blend of the nearest palette
colors (in Lab space) via a 3D LUT, then part of the original lightness is
restored so the image keeps its depth.

Usage: catppuccinify IMAGE [-o OUT] [--sigma 10] [--keep-lightness 0.6]
"""
import argparse
from pathlib import Path

import numpy as np
from PIL import Image

Image.MAX_IMAGE_PIXELS = None

MOCHA = """f5e0dc f2cdcd f5c2e7 cba6f7 f38ba8 eba0ac fab387 f9e2af a6e3a1 94e2d5 89dceb
74c7ec 89b4fa b4befe cdd6f4 bac2de a6adc8 9399b2 7f849c 6c7086 585b70 45475a 313244
1e1e2e 181825 11111b""".split()

M = np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]])
WHITE = np.array([0.95047, 1.0, 1.08883])
LUT_SIZE = 65
CHUNK = 4_000_000


def lab(rgb):
    c = np.where(rgb > 0.04045, ((rgb + 0.055) / 1.055) ** 2.4, rgb / 12.92)
    xyz = c @ M.T / WHITE
    f = np.where(xyz > 0.008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
    return np.stack([116 * f[..., 1] - 16, 500 * (f[..., 0] - f[..., 1]), 200 * (f[..., 1] - f[..., 2])], -1)


def rgb_from_lab(L):
    fy = (L[..., 0] + 16) / 116
    f = np.stack([fy + L[..., 1] / 500, fy, fy - L[..., 2] / 200], -1)
    xyz = np.where(f > 0.2069, f**3, (f - 16 / 116) / 7.787) * WHITE
    c = np.clip(xyz @ np.linalg.inv(M).T, 0, 1)
    return np.where(c > 0.0031308, 1.055 * c ** (1 / 2.4) - 0.055, 12.92 * c)


def build_lut(palette, sigma, keep_lightness):
    pal = np.array([[int(h[i : i + 2], 16) for i in (0, 2, 4)] for h in palette], float) / 255
    g = np.linspace(0, 1, LUT_SIZE)
    grid = np.stack(np.meshgrid(g, g, g, indexing="ij"), -1).reshape(-1, 3)
    gl, pl = lab(grid), lab(pal)
    diff = gl[:, None, :] - pl[None, :, :]
    diff[..., 0] *= 0.5  # weigh hue/chroma over lightness when matching
    d2 = (diff**2).sum(-1)
    w = np.exp(-(d2 - d2.min(1, keepdims=True)) / (2 * sigma**2))
    mapped = lab((w / w.sum(1, keepdims=True)) @ pal)
    mapped[:, 0] = keep_lightness * gl[:, 0] + (1 - keep_lightness) * mapped[:, 0]
    return rgb_from_lab(mapped).reshape(LUT_SIZE, LUT_SIZE, LUT_SIZE, 3).astype(np.float32)


def apply_lut(img, lut):
    n = lut.shape[0]
    out = np.empty_like(img)
    flat, oflat = img.reshape(-1, 3), out.reshape(-1, 3)
    for s in range(0, len(flat), CHUNK):
        p = flat[s : s + CHUNK].astype(np.float32) / 255 * (n - 1)
        i0 = np.minimum(p.astype(int), n - 2)
        f = p - i0
        r = np.zeros((len(p), 3), np.float32)
        for dx in (0, 1):  # trilinear interpolation
            for dy in (0, 1):
                for dz in (0, 1):
                    wt = (f[:, 0] if dx else 1 - f[:, 0]) * (f[:, 1] if dy else 1 - f[:, 1]) * (f[:, 2] if dz else 1 - f[:, 2])
                    r += wt[:, None] * lut[i0[:, 0] + dx, i0[:, 1] + dy, i0[:, 2] + dz]
        oflat[s : s + CHUNK] = np.clip(r * 255 + 0.5, 0, 255).astype(np.uint8)
    return out


def main():
    ap = argparse.ArgumentParser(description="Recolor an image to Catppuccin Mocha.")
    ap.add_argument("image", type=Path)
    ap.add_argument("-o", "--output", type=Path, help="default: <name>-mocha.png next to the input")
    ap.add_argument("--sigma", type=float, default=10, help="palette blend softness; lower = more posterized (default 10)")
    ap.add_argument("--keep-lightness", type=float, default=0.6, help="0-1, how much original lightness to keep (default 0.6)")
    args = ap.parse_args()

    out = args.output or args.image.with_name(f"{args.image.stem}-mocha.png")
    img = np.asarray(Image.open(args.image).convert("RGB"))
    Image.fromarray(apply_lut(img, build_lut(MOCHA, args.sigma, args.keep_lightness))).save(out)
    print(out)


if __name__ == "__main__":
    main()
